# Copy to .env. Do not put a database path in the URI; set the name below.
MONGODB_HOST=mongodb://localhost:27017/
MONGODB_DB=skipq_dev

# Q4 functional tests require real MongoDB and an EMPTY dedicated database.
# The fixtures remove only the test database they claimed for this run.
TEST_MONGODB_HOST=mongodb://localhost:27017/
TEST_MONGODB_DB=skipq_test_q4
